<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's Dark Mode setting is off.
         Uses the AndroidX SplashScreen compat theme so the mandatory Android 12+
         system splash shows the same white background and GoLazy key mark that
         opens splashscreen.png, instead of the generic launcher icon treatment,
         so the OS-controlled phase reads as the start of one continuous GoLazy
         splash rather than a separate screen. It hands off to NormalTheme (and
         Flutter's own splashscreen.png) as soon as the first frame is drawn. -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_key_icon</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
